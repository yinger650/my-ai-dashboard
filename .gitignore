# Go
/bin/
/board-server
/board-client
*.test
coverage.out

# Node / frontend
node_modules/
web/node_modules/

# Built frontend output is generated by `make build` / `pnpm --dir web build`.
# Keep the directory (with .gitkeep) so `//go:embed all:dist` always compiles.
web/dist/*
!web/dist/.gitkeep

# Local data / runtime
*.db
*.db-wal
*.db-shm
/tmp/
*.local
.DS_Store
__pycache__/
*.pyc
