[Unit]
Description=AgentBoard Personal board-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/agentboard/board-server.env
ExecStart=/opt/agentboard/bin/board-server run
WorkingDirectory=/opt/agentboard
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
