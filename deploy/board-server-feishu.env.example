ABP_LISTEN_ADDR=127.0.0.1:8091
ABP_PUBLIC_URL=https://board-feishu.example.com
ABP_DATA_DIR=/var/lib/agentboard-feishu
ABP_SECURE_COOKIES=true
ABP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ABP_LOG_LEVEL=info
ABP_SESSION_HOURS=12
ABP_EVENT_RETENTION_DAYS=30
ABP_ACCESS_RETENTION_DAYS=30
ABP_RAW_METRIC_RETENTION_DAYS=30
ABP_EVENT_QUOTA_BYTES=5368709120

# Feishu enterprise app
ABP_FEISHU_APP_ID=
ABP_FEISHU_APP_SECRET=
# Optional; defaults to $ABP_PUBLIC_URL/auth/feishu/callback
# ABP_FEISHU_REDIRECT_URI=
# Optional extra check against user_info.tenant_key
# ABP_FEISHU_TENANT_KEY=
