ABP_LISTEN_ADDR=127.0.0.1:8090
ABP_PUBLIC_URL=https://board.yinger650.com
ABP_DATA_DIR=/var/lib/agentboard
ABP_SECURE_COOKIES=true
ABP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
ABP_LOG_LEVEL=info
ABP_SESSION_HOURS=12
ABP_EVENT_RETENTION_DAYS=30
ABP_ACCESS_RETENTION_DAYS=30
ABP_RAW_METRIC_RETENTION_DAYS=30
ABP_EVENT_QUOTA_BYTES=5368709120
# Optional 32-byte AES key (hex/base64/raw). If unset, board-server creates DataDir/master.key.
# ABP_SECRET_KEY=
